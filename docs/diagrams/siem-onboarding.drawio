<mxfile host="app.diagrams.net"><diagram name="Onboarding a new log source into Wazuh: the Squid egress proxy (Shadow AI)"><mxGraphModel dx="1600" dy="470" grid="1" gridSize="10" page="1" pageWidth="1600" pageHeight="470"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="Same pattern used for the other sources in this lab" style="rounded=1;arcSize=3;dashed=1;fillColor=#F8FAFC;strokeColor=#475569;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontColor=#475569;html=1;" vertex="1" parent="1"><mxGeometry x="30" y="260" width="1540" height="190" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;1 Emit structured&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Squid logformat 'siljson'&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;one JSON object per line&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;(no custom decoder needed)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEDD5;strokeColor=#C2410C;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="30" y="90" width="230" height="130" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;2 Collect&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;file mounted read-only&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;/var/log/sil/squid/access.json&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;&amp;lt;localfile&amp;gt; log_format json&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="290" y="90" width="230" height="130" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;3 Decode&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;built-in JSON decoder&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;fields: src_ip, url, action,&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;status, dest_host&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#1D4ED8;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="550" y="90" width="230" height="130" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;4 Detect&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;100100 any Squid event (3)&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;100101 consumer AI host (10)&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;100102 10 in 10 min (12)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#15803D;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="810" y="90" width="230" height="130" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;5 Test&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;wazuh-logtest with&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;siem/sample-logs/squid.json&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;evidence 11&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0369A1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1070" y="90" width="230" height="130" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;6 Operate&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;dashboard + alert routing&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;runbook: who, what, why&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;evidence 13, 14&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2E8F0;strokeColor=#1E293B;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1330" y="90" width="230" height="130" as="geometry"/></mxCell><mxCell id="c10" value="" style="edgeStyle=none;html=1;strokeColor=#334155;strokeWidth=2;fontColor=#334155;fontStyle=1;endArrow=block;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="260" y="155" as="sourcePoint"/><mxPoint x="290" y="155" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c11" value="" style="edgeStyle=none;html=1;strokeColor=#334155;strokeWidth=2;fontColor=#334155;fontStyle=1;endArrow=block;" edge="1" 