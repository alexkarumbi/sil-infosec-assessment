<mxfile host="app.diagrams.net"><diagram name="Secure AI-assisted delivery pipeline: where each SAST, SCA, DAST and SIEM control sits"><mxGraphModel dx="1600" dy="780" grid="1" gridSize="10" page="1" pageWidth="1600" pageHeight="780"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="1  Developer laptop" style="rounded=1;arcSize=3;dashed=1;fillColor=#FAF5FF;strokeColor=#5B21B6;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontColor=#5B21B6;html=1;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="300" height="560" as="geometry"/></mxCell><mxCell id="c4" value="2  Pull request: GitHub Actions (blocking)" style="rounded=1;arcSize=3;dashed=1;fillColor=#F0F9FF;strokeColor=#0369A1;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontColor=#0369A1;html=1;" vertex="1" parent="1"><mxGeometry x="345" y="60" width="760" height="560" as="geometry"/></mxCell><mxCell id="c5" value="3  Merge, deploy, run" style="rounded=1;arcSize=3;dashed=1;fillColor=#F8FAFC;strokeColor=#1E293B;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontColor=#1E293B;html=1;" vertex="1" parent="1"><mxGeometry x="1130" y="60" width="450" height="560" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;AI coding assistant&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Copilot / ChatGPT suggestions&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#5B21B6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="45" y="100" width="250" height="70" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Developer reviews + commits&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;owns every AI-suggested line&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#5B21B6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="45" y="215" width="250" height="70" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Pre-commit hooks&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Gitleaks + custom&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;db-connection-string rule&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;private-key + large-file check&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Bandit (medium+)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#5B21B6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="45" y="330" width="250" height="135" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Commit blocked locally&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;evidence 24, 26&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#B91C1C;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="45" y="520" width="250" height="70" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Secret scanning&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Gitleaks on the whole git history&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#B45309;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="370" y="100" width="330" height="80" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;SAST&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Semgrep registry rules + 3 SIL rules&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;(no auth, IDOR, f-string SQL)&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Bandit; SARIF to code scanning&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#1D4ED8;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="370" y="200" width="330" height="100" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;SCA + supply chain&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;package exists + older than 90 days&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;(AI-hallucinated packages)&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;pip-audit, Trivy, CycloneDX SBOM&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#6D28D9;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="370" y="320" width="330" height="120" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Unit tests&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;token forgery, IDOR scoping, guardrails&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0369A1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="370" y="460" width="330" height="80" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Ephemeral lab on the runner&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;WAF + Kong + APIs + AI gateway + Squid&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="760" y="100" width="320" height="80" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Integration + authorisation matrix&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;every role x every endpoint&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;x own / other facility&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0369A1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="760" y="200" width="320" height="90" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;ZAP baseline (passive)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;through the WAF, every pull request&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;about 2 minutes, no attacks&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#15803D;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="760" y="310" width="320" height="90" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;ZAP API scan (active)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;direct to each API, OpenAPI-driven&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;main + nightly 04:00 Nairobi&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;fails on SQLi / XSS (rules.tsv)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#15803D;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="760" y="420" width="320" height="100" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Merge gate&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;all checks green + human review for AI-assisted PRs&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#047857;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1155" y="100" width="400" height="80" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;Deploy&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;same images that were scanned (SBOM kept)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#047857;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1155" y="215" width="400" height="70" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;Runtime controls&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;WAF, API gateway, AI guardrails, egress proxy&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Wazuh agents (Sysmon, file integrity)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEDD5;strokeColor=#C2410C;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1155" y="320" width="400" height="100" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;Wazuh SIEM&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Shadow AI, guardrail blocks, WAF attacks,&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;ransomware behaviour -&amp;gt; analyst&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;findings feed new rules and tests&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2E8F0;strokeColor=#1E293B;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1155" y="450" width="400" height="110" as="geometry"/></mxCell><mxCell id="c22" value="suggests code" style="edgeStyle=none;html=1;strokeColor=#334155;strokeWidth=2;fontColor=#334155;fontStyle=1;endArrow=block;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="170" y="170" as="sourcePoint"/><mxPoint x="170" y="215" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c23" value="git commit" style="edgeStyle=none;html=1;strokeColor=#334155;strokeWidth=2;fontColor=#334155;fontStyle=1;endArrow=block;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="170" y="285" as="sourcePoint"/><mxPoint x="170" y="330" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c24" value="secret or high finding" style="edgeStyle=none;html=1;strokeColor=#B91C1C;strokeWidth=2;fontColor=#B91C1C;fontStyle=1;endArrow=block;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="170" y="465" as="sourcePoint"/><mxPoint x="170" y="520" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c25" value="" style="edgeStyle=none;html=1;strokeColor=#334155;strokeWidth=2;fontColor=#334155;fontStyle=1;endArrow=block;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="295" y="397" as="sourcePoint"/><mxPoint x="370" y="140" as="targetPoint"/><Array as="points"><mxPoint x="330" y="397"/><mxPoint x="330" y="500"/><mxPoint x="330" y="140"/><mxPoint x="345" y="140"/></Array></mxGeometry></mxCell><mxCell id="c26" value="" style="edgeStyle=none;html=1;strokeColor=#334155;strokeWidth=2;fontColor=#334155;fontStyle=1;endArrow=block;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="330" y="250" as="sourcePoint"/><mxPoint x="370" y="250" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c27" value="" style="edgeStyle=none;html=1;strokeColor=#334155;strokeWidth=2;fontColor=#334155;fontStyle=1;endArrow=block;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="330" y="380" as="sourcePoint"/><mxPoint x="370" y="380" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c28" value="" style="