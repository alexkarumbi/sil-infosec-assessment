<mxfile host="app.diagrams.net"><diagram name="SIL API gateway, WAF and AI guardrail architecture (lab build, production mapping in the text)"><mxGraphModel dx="1600" dy="1010" grid="1" gridSize="10" page="1" pageWidth="1600" pageHeight="1010"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="1  Users and partners (untrusted)" style="rounded=1;arcSize=3;dashed=1;fillColor=#FFFFFF;strokeColor=#64748B;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontColor=#64748B;html=1;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="245" height="600" as="geometry"/></mxCell><mxCell id="c4" value="2  Edge (only published ports)" style="rounded=1;arcSize=3;dashed=1;fillColor=#FFFBEB;strokeColor=#B45309;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontColor=#B45309;html=1;" vertex="1" parent="1"><mxGeometry x="285" y="60" width="260" height="600" as="geometry"/></mxCell><mxCell id="c5" value="3  Private application network (no route in or out)" style="rounded=1;arcSize=3;dashed=1;fillColor=#F0F9FF;strokeColor=#0369A1;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontColor=#0369A1;html=1;" vertex="1" parent="1"><mxGeometry x="565" y="60" width="690" height="600" as="geometry"/></mxCell><mxCell id="c6" value="4  Controlled egress" style="rounded=1;arcSize=3;dashed=1;fillColor=#FFF7ED;strokeColor=#C2410C;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontColor=#C2410C;html=1;" vertex="1" parent="1"><mxGeometry x="1275" y="290" width="305" height="190" as="geometry"/></mxCell><mxCell id="c7" value="5  Approved external AI" style="rounded=1;arcSize=3;dashed=1;fillColor=#FFFFFF;strokeColor=#475569;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontColor=#475569;html=1;" vertex="1" parent="1"><mxGeometry x="1275" y="60" width="305" height="210" as="geometry"/></mxCell><mxCell id="c8" value="6  Security monitoring (Wazuh SIEM)" style="rounded=1;arcSize=3;dashed=1;fillColor=#F8FAFC;strokeColor=#1E293B;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontColor=#1E293B;html=1;" vertex="1" parent="1"><mxGeometry x="20" y="730" width="1560" height="260" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Clinician app&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;web / mobile&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;logs in with MFA&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="205" height="80" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Partner system&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;lab / insurer / HIE&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;client credentials&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="250" width="205" height="80" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Staff browser&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;tries ChatGPT etc.&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;(Shadow AI)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="470" width="205" height="80" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;WAF&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;ModSecurity v3 +&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;OWASP Core Rule Set&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;blocks SQLi, XSS, traversal&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;:8080 (TLS at edge in prod)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#B45309;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="305" y="150" width="220" height="120" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Identity provider&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Keycloak (OpenID Connect)&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;MFA, brute-force lockout&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;roles + facility groups&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;10-minute RS256 tokens&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#B45309;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="305" y="360" width="220" height="120" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;API gateway (Kong)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;verify JWT signature + expiry&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;rate limit 60/min, AI 10/min&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;1 MB body limit, request ID&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;security headers, access log&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#1D4ED8;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="585" y="175" width="215" height="140" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Patients API&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;clinician role, own facility&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0369A1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="845" y="100" width="200" height="66" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;Appointments API&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;clinician / receptionist&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0369A1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="845" y="195" width="200" height="66" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;PostgreSQL&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;parameterised queries&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;rows tagged facility_id&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#6D28D9;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1085" y="140" width="150" height="90" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;AI guardrail gateway&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;1 injection: regex + DeBERTa&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;2 secrets  3 PHI IDs -&amp;gt; block&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;4 names/phones -&amp;gt; mask&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;5 mask PII in the answer&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;logs hash only, never prompt&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#15803D;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="845" y="330" width="240" height="140" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;Local model (Ollama)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;lab stand-in for the LLM&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#15803D;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="845" y="545" width="240" height="60" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;Egress proxy (Squid)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;allow LLM only from&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;AI gateway 172.30.0.10&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;deny consumer AI + log&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;JSON log -&amp;gt; SIEM&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEDD5;strokeColor=#C2410C;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1300" y="335" width="255" height="120" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;Enterprise LLM&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;private endpoint&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;(e.g. Azure OpenAI / Bedrock)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#475569;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1300" y="105" width="255" height="80" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;Consumer AI sites&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;chatgpt.com, claude.ai&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#B91C1C;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1390" y="545" width="175" height="70" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;Windows endpoint agent&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Sysmon process events&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;real-time file integrity&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;monitoring&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2E8F0;strokeColor=#1E293B;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="60" y="800" width="260" height="100" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;Wazuh SIEM&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;manager: decoders + SIL rules 100100-100202&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;indexer + dashboard (localhost only)&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Shadow AI, guardrail, WAF, ransomware&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;MITRE ATT&amp;amp;CK tags T1567 T1190 T1486 T1490&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2E8F0;strokeColor=#1E293B;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="640" y="790" width="380" height="130" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;Analyst triage&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;alert -&amp;gt; investigate -&amp;gt; contain&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Duty to Report path&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2E8F0;strokeColor=#1E293B;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1240" y="800" width="290" height="100" as="geometry"/></mxCell><mxCell id="c26" value="HTTPS + bearer token" style="edgeStyle=none;html=1;strokeColor=#334155;strokeWidth=2;fontColor=#334155;fontStyle=1;endArrow=block;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="245" y="150" as="sourcePoint"/><mxPoint x="305" y="190" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c27" value="" style="edgeStyle=none;html=1;strokeColor=#334155;strokeWidth=2;fontColor=#334155;fontStyle=1;endArrow=block;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="245" y="290" as="sourcePoint"/><mxPoint x="305" y="230" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c28" value="" style="edgeStyle=none;html=1;strokeColor=#7C3AED;strokeWidth=2;fontColor=#7C3AED;fontStyle=1;endArrow=block;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="150" y="190" as="sourcePoint"/><mxPoint x="305" y="400" as="targetPoint"/><Array as="points"><mxPoint x="150" y="215"/><mxPoint x="280" y="215"/><mxPoint x="280" y="400"/></Array></mxGeometry></mxCell><mxCell id="c29" value="" style="edgeStyle=none;html=1;strokeColor=#7C3AED;strokeWidth=2;fontColor=#7C3AED;fontStyle=1;endArrow=block;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="245" y="300" as="sourcePoint"/><mxPoint x="305" y="430" as="targetPoint"/><Array as="points"><mxPoint x="270" y="300"/><mxPoint x="270" y="430"/></Array></mxGeometry></mxCell><mxCell id="c30" value="clean traffic" style="edgeStyle=none;html=1;strokeColor=#334155;strokeWidth=2;fontColor=#334155;fontStyle=1;endArrow=block;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="525" y="210" as="sourcePoint"/><mxPoint x="585" y="225" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c31" value="signing key (JWKS)" style="edgeStyle=none;html=1;strokeColor=#7C3AED;strokeWidth=2;fontColor=#7C3AED;fontStyle=1;endArrow=blo