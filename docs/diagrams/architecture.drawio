/></mxCell><mxCell id="c58" value="teal dotted = logs to the SIEM" style="text;html=1;fontSize=11.5;fontColor=#0F766E;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="895" y="948.5" width="207.0" height="19.5" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>