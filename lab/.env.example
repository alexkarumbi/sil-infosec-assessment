# Copy to lab/.env and change every value. lab/.env is git-ignored: never commit it.
# Use letters and digits only for DB_PASSWORD (it is placed inside a connection URL).
KC_ADMIN_PASSWORD=change-me-admin
LAB_USER_PASSWORD=change-me-users
DB_PASSWORD=changeme123

# true = full guardrails incl. the DeBERTa prompt-injection model (image is ~3 GB, needs ~2 GB RAM)
# false = Presidio + regex only (light, used in CI)
WITH_ML_DETECTOR=true
# true = no model call; the gateway echoes the masked prompt (useful to prove masking)
MOCK_LLM=false
UPSTREAM_MODEL=qwen2.5:0.5b
# en_core_web_lg = accurate name detection (recommended); en_core_web_sm = small and less accurate
SPACY_MODEL=en_core_web_lg
