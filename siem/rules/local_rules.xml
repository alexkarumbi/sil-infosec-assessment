<!--
  SIL Infosec Assessment - Wazuh custom rules (mounted to /var/ossec/etc/rules/local_rules.xml).
  Test a log line: docker exec -it single-node-wazuh.manager-1 /var/ossec/bin/wazuh-logtest
  Sample lines are in siem/sample-logs/.
-->

<!-- ===== Shadow AI: consumer LLM access seen at the Squid egress proxy (new log source) ===== -->
<group name="sil,shadow_ai,">
  <rule id="100100" level="3">
    <decoded_as>json</decoded_as>
    <field name="log_source">^squid$</field>
    <description>SIL: Squid egress proxy event</description>
  </rule>

  <rule id="100101" level="10">
    <if_sid>100100</if_sid>
    <url type="pcre2">(?i)(chatgpt\.com|chat\.openai\.com|claude\.ai|gemini\.google\.com|copilot\.microsoft\.com|perplexity\.ai|chat\.deepseek\.com|poe\.com)</url>
    <description>SIL Shadow AI: $(src_ip) tried to reach consumer LLM $(url) (proxy action $(action))</description>
    <mitre>
      <id>T1567</id>
    </mitre>
  </rule>

  <rule id="100102" level="12" frequency="10" timeframe="600">
    <if_matched_sid>100101</if_matched_sid>
    <same_field>src_ip</same_field>
    <description>SIL Shadow AI: 10 or more consumer LLM attempts from $(src_ip) in 10 minutes</description>
    <mitre>
      <id>T1567</id>
    </mitre>
  </rule>
</group>

<!-- ===== AI guardrail gateway decisions ===== -->
<group name="sil,ai_gateway,">
  <rule id="100110" level="3">
    <decoded_as>json</decoded_as>
    <field name="log_source">^ai_gateway$</field>
    <description>SIL AI gateway decision</description>
  </rule>

  <rule id="100111" level="12">
    <if_sid>100110</if_sid>
    <field name="reason">^phi_detected$|^secret_detected$</field>
    <description>SIL AI guardrail blocked $(reason) from user $(dstuser)</description>
  </rule>

  <rule id="100112" level="10">
    <if_sid>100110</if_sid>
    <field name="reason">^prompt_injection$</field>
    <description>SIL AI guardrail blocked a prompt injection attempt from user $(dstuser)</description>
  </rule>

  <rule id="100113" level="12" frequency="5" timeframe="300">
    <if_matched_sid>100112</if_matched_sid>
    <same_user />
    <description>SIL AI guardrail: repeated prompt injection attempts from user $(dstuser)</description>
  </rule>
</group>

<!-- ===== WAF (ModSecurity JSON audit log) ===== -->
<group name="sil,waf,">
  <rule id="100120" level="5">
    <decoded_as>json</decoded_as>
    <field name="transaction.is_interrupted">^true$</field>
    <description>SIL WAF blocked a request from $(transaction.client_ip)</description>
  </rule>

  <rule id="100121" level="10" frequency="20" timeframe="120">
    <if_matched_sid>100120</if_matched_sid>
    <same_field>transaction.client_ip</same_field>
    <description>SIL WAF: sustained attack from $(transaction.client_ip) (20 blocks in 2 minutes)</description>
    <mitre>
      <id>T1190</id>
    </mitre>
  </rule>
</group>

<!-- ===== Ransomware behaviour (Windows agent: file integrity monitoring + Sysmon) ===== -->
<group name="sil,ransomware,">
  <rule id="100200" level="12" frequency="25" timeframe="60">
    <if_matched_group>syscheck_file</if_matched_group>
    <description>SIL possible ransomware: 25 or more file changes (add/modify/delete) in 60 seconds</description>
    <mitre>
      <id>T1486</id>
    </mitre>
  </rule>

  <!-- If this never fires, your Wazuh version may expose the path as field "file": swap the name and retest. -->
  <rule id="100201" level="12">
    <if_sid>554</if_sid>
    <field name="file" type="pcre2">(?i)\.(locked|encrypted|crypt|enc)$</field>
    <description>SIL possible ransomware: encrypted-extension file created $(file)</description>
    <mitre>
      <id>T1486</id>
    </mitre>
  </rule>

  <rule id="100202" level="14">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)vssadmin(\.exe)?\s+delete\s+shadows|wmic(\.exe)?\s+shadowcopy\s+delete|bcdedit.*recoveryenabled\s+no|wbadmin(\.exe)?\s+delete\s+catalog</field>
    <description>SIL ransomware precursor: backup or shadow-copy deletion command: $(win.eventdata.commandLine)</description>
    <mitre>
      <id>T1490</id>
    </mitre>
  </rule>
</group>
